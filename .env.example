# FleetPulse Environment Configuration Template
PROJECT_NAME="FleetPulse Connected Vehicle Intelligence"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-random-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Multi-Tenant Default
DEFAULT_TENANT_ID="e2b10a24-1f33-4f24-9df2-5c8e44123456"

# Polyglot Storage
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fleetpulse"
CLICKHOUSE_HOST="localhost"
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE="fleetpulse"
REDIS_URL="redis://localhost:6379/0"
MONGO_URL="mongodb://localhost:27017"

# Streaming Message Broker
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"

# Allowed CORS Origins
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000"]
